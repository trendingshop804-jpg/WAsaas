# Node.js / React
node_modules/
build/
# Python / FastAPI
__pycache__/
*.pyc
.venv/

# Environment files — NEVER commit real secrets
.env
.env.local
.env*.local
# .env.example is safe to commit — it has placeholder values only

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel
.env*
# Exception: the example template is safe to commit (no real secrets)
!.env.example

# Browser API key config — never commit this
js/config.js

# SQLite database files — may contain real client data
*.db
*.sqlite
*.sqlite3

# Large binary executables — install separately, do not commit
cloudflared.exe
*.exe

# Next.js build output
.next/
out/
