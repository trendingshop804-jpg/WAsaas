// ============================================================================
// NexusLead AI — Multi-Tenant PostgreSQL Prisma Schema
// Enterprise Schema for Lead Generation, WhatsApp Automation & CRM Platform
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES_AGENT
  VIEWER
}

enum LeadScoreCategory {
  HOT
  WARM
  COLD
  UNQUALIFIED
}

enum PipelineStage {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
}

enum WhatsAppProviderType {
  META_CLOUD_API
  AUTHORIZED_QR_GATEWAY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Organization {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  industry          String?
  website           String?
  location          String?
  timezone          String                 @default("Asia/Kolkata")
  plan              String                 @default("growth")
  creditsUsed       Int                    @default(0)
  creditsLimit      Int                    @default(5000)
  isPaused          Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  users             User[]
  leads             Lead[]
  campaigns         Campaign[]
  workflows         Workflow[]
  conversations     Conversation[]
  connections       WhatsAppConnection[]
  templates         Template[]
  auditLogs         AuditLog[]
  optOuts           OptOut[]
}

model User {
  id                String                 @id @default(uuid())
  email             String                 @unique
  passwordHash      String
  name              String
  role              Role                   @default(SALES_AGENT)
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads     Lead[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId])
}

model Lead {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName       String
  contactName       String
  jobTitle          String?
  phone             String
  email             String?
  website           String?
  industry          String?
  location          String?
  source            String                 @default("Discovery")
  sourceUrl         String?
  score             Int                    @default(50)
  scoreCategory     LeadScoreCategory      @default(WARM)
  status            PipelineStage          @default(NEW)
  optedOut          Boolean                @default(false)
  notes             String?
  customFields      Json?
  aiSummary         String?

  assignedToId      String?
  assignedTo        User?                  @relation(fields: [assignedToId], references: [id])
  campaignId        String?
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])

  conversation      Conversation?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@index([organizationId, score])
}

model WhatsAppConnection {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          WhatsAppProviderType   @default(META_CLOUD_API)
  phoneNumber       String
  wabaId            String?
  phoneNumberId     String?
  accessTokenHash   String?
  isActive          Boolean                @default(true)
  connectedAt       DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId])
}

model Template {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  category          String                 @default("MARKETING")
  language          String                 @default("en_US")
  body              String
  variables         String[]
  metaStatus        String                 @default("APPROVED")
  createdAt         DateTime               @default(now())

  campaigns         Campaign[]

  @@index([organizationId])
}

model Campaign {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  status            CampaignStatus         @default(SCHEDULED)
  templateId        String
  template          Template               @relation(fields: [templateId], references: [id])
  dailyLimit        Int                    @default(150)
  sendingWindow     String                 @default("09:30 AM - 06:30 PM IST")
  totalLeads        Int                    @default(0)
  sentCount         Int                    @default(0)
  deliveredCount    Int                    @default(0)
  replyCount        Int                    @default(0)
  qualifiedCount    Int                    @default(0)
  wonCount          Int                    @default(0)

  leads             Lead[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId])
}

model Conversation {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String                 @unique
  lead              Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mode              String                 @default("AI") // AI or HUMAN
  unreadCount       Int                    @default(0)
  lastMessage       String?
  lastTimestamp     DateTime               @default(now())

  messages          Message[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId])
}

model Message {
  id                String                 @id @default(uuid())
  conversationId    String
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  isAI              Boolean                @default(false)
  body              String
  status            MessageStatus          @default(SENT)
  metaMessageId     String?
  createdAt         DateTime               @default(now())

  @@index([conversationId])
}

model Workflow {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  graphJson         Json
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId])
}

model OptOut {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phone             String
  reason            String?
  createdAt         DateTime               @default(now())

  @@unique([organizationId, phone])
}

model AuditLog {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action            String
  entity            String
  actor             String
  details           String?
  status            String                 @default("Success")
  createdAt         DateTime               @default(now())

  @@index([organizationId, createdAt])
}
