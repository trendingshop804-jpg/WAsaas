# .vercelignore
# Files/directories that must never be uploaded in a Vercel deployment.
# NOTE: .gitignore is NOT consulted for the Vercel upload, so anything that
# should not reach the CDN must be listed here explicitly.

# Customer data / restorable database dumps (contains real PII)
backups/
scratch/
*.sql.gz

# Secrets and local env
.env
.env.*
!.env.example

# Repositories, tooling and local state
.git
.agents/
.claude/
.kilo/
.playwright-mcp/
.vercel/

# Tests, tooling and docs not needed at runtime
scripts/
supabase/migrations-backup/
supabase/migrations-review-copy/
supabase/migrations-pending-hold/
supabase/.temp/
CODEBASE_DOCUMENTATION.md
migration-review.txt
index.nextbright-backup.html

# Server-side handlers live in server/api/ (imported by the single api/[slug].js
# dispatcher — they MUST be uploaded for Vercel to bundle them).
# Only the archived copies stay excluded:
server/_retired/

# Nested duplicate checkout of this same repository (extraction artifact) —
# never serve a second copy of the code or its api/ handlers from the CDN.
WAsaas-main/

# Backups of prior module versions
*.bak
*.before-*
*.pre-*

# Local binaries and databases
*.exe
*.db
*.sqlite
*.sqlite3
cloudflared.exe

# Python / build artefacts
.venv/
__pycache__/
*.pyc
dist/
