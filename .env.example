# =============================================================================
# NexusLead AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is gitignored.
# =============================================================================

# === Meta WhatsApp Business Cloud API ===
# From: https://developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id
WABA_ID=your-whatsapp-business-account-id

# === Meta Webhook Verification ===
# Set this to any random secret string. Must match what you register in Meta Developer Portal.
META_VERIFY_TOKEN=your-meta-webhook-verify-token
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# === OpenRouter AI (for AI message generation) ===
# From: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === OpenAI (optional — only if calling OpenAI directly) ===
OPENAI_API_KEY=your-openai-api-key

# === Ngrok (for local dev tunneling to expose localhost to Meta webhooks) ===
# From: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your-ngrok-auth-token

# === Supabase ===
# From: https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional legacy alias accepted by the cron endpoints.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# === Scheduled lead follow-ups (Vercel Cron) ===
# Generate a long random value and add the same value in Vercel Project Settings.
CRON_SECRET=your-long-random-cron-secret
# Optional aliases accepted by the cron endpoints (primary names are above).
WA_ACCESS_TOKEN=your-whatsapp-permanent-access-token
WA_PHONE_NUMBER_ID=your-phone-number-id

# === Meta App (for OAuth exchange + profile management Edge Functions) ===
# From: https://developers.facebook.com/apps/ > Your App > Settings > Basic
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Required for AES-GCM encryption of stored tokens in whatsapp_connections.instagram_connections
INTEGRATION_ENCRYPT_SECRET=your-32-char-minimum-encryption-secret-here

# === Database (for backend/server.py FastAPI backend) ===
# For local dev, you can use SQLite: sqlite:///./nexuslead.db
# For production, use a Postgres URL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./nexuslead.db

# === App Settings ===
PORT=8000
NODE_ENV=development
